# Copy to .env and fill in. ".env" is gitignored and never leaves this machine.
# The scripts in scripts/ read these values. n8n itself keeps the real secrets
# (OpenAI key, Telegram bot tokens, Google OAuth) in its own credential store.

# --- n8n Cloud -------------------------------------------------------------
# Instance URL, e.g. https://chen-erp.app.n8n.cloud
N8N_URL=
# Settings -> n8n API -> Create an API key
N8N_API_KEY=

# --- Airtable --------------------------------------------------------------
# Personal access token with scopes: data.records:read, data.records:write,
# schema.bases:read, schema.bases:write  (on the ERP base only)
AIRTABLE_PAT=
# The base id from the URL: https://airtable.com/appXXXXXXXXXXXXXX/...
AIRTABLE_BASE_ID=

# --- Owner -----------------------------------------------------------------
# Your Telegram chat id (send a message to the manager bot, then open
# https://api.telegram.org/bot<MANAGER_BOT_TOKEN>/getUpdates and copy "chat":{"id":...})
OWNER_TELEGRAM_CHAT_ID=
# The Gmail address connected in n8n. Lead-alert emails go here, and demo leads use
# plus-addressing (you+lead-dana@gmail.com) so cold emails land in this inbox.
OWNER_EMAIL=

# --- n8n credential IDs ----------------------------------------------------
# Create the 6 credentials in n8n (Credentials -> Add), open each one and copy the
# id from the URL: https://<instance>/home/credentials/<ID>
CRED_OPENAI=
CRED_AIRTABLE=
CRED_TELEGRAM_MANAGER=
CRED_TELEGRAM_SUPPORT=
CRED_GMAIL=
CRED_GDRIVE=

# --- n8n form triggers (WF6 / WF7) -----------------------------------------
# n8n serves each Form Trigger at /form/<trigger id>. Open the trigger node in n8n and copy the
# id from its "Production URL" (the part after /form/). load_rag.py posts the files there.
FORM_POLICIES_ID=
FORM_PRODUCTS_ID=
