    {
      "parameters": {
        "content": "### Last Invoice Number\nשולף את החשבונית עם המספר הגבוה ביותר. הבסיס למספור העוקב. אם אין אף אחת, ממשיכים (Continue on error) ומתחילים מ-INV-0001.",
        "height": 190,
        "width": 240,
        "color": 1
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        540,
        -210
      ],
      "name": "Note 6",
      "id": "593d0afb-5a2b-5635-8d54-ecc959314fa2"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "3ac79784-80a2-5200-9efb-6d54e853a748",
              "name": "rate",
              "type": "number",
              "value": "={{ new Date($('Invoice Created').item.json.fields.Created) >= new Date('2025-01-01') ? 0.18 : 0.17 }}"
            },
            {
              "id": "1cfe52bc-c5e8-5883-9116-89de82259953",
              "name": "VatAmount",
              "type": "number",
              "value": "={{ Math.round(Number($('Invoice Created').item.json.fields.Amount) * (new Date($('Invoice Created').item.json.fields.Created) >= new Date('2025-01-01') ? 0.18 : 0.17) * 100) / 100 }}"
            },
            {
              "id": "07bd4d13-cd0e-5ac5-96d9-8cd244f2d285",
              "name": "Total",
              "type": "number",
              "value": "={{ Math.round((Number($('Invoice Created').item.json.fields.Amount) + Math.round(Number($('Invoice Created').item.json.fields.Amount) * (new Date($('Invoice Created').item.json.fields.Created) >= new Date('2025-01-01') ? 0.18 : 0.17) * 100) / 100) * 100) / 100 }}"
            },
            {
              "id": "23c663a6-7db6-5fee-b060-bd92aa60395e",
              "name": "InvoiceNumber",
              "type": "string",
              "value": "={{ 'INV-' + ((parseInt((($json.fields || {}).InvoiceNumber || 'INV-0000').split('-')[1]) || 0) + 1).toString().padStart(4, '0') }}"
            },
            {
              "id": "ddc356ff-b523-4a14-adae-f26ded323e57",
              "name": "DocType",
              "type": "string",
              "value": "={{ $('Invoice Created').item.json.fields.DocType || 'חשבונית מס' }}"
            }
          ]
        },
        "options": {}
      },
