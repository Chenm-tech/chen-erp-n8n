    {
      "parameters": {
        "html": "<!DOCTYPE html>\n<html lang=\"he\" dir=\"rtl\">\n<head><meta charset=\"utf-8\"><title>{{ $json.fields.DocType || 'חשבונית מס' }} {{ $json.fields.InvoiceNumber }}</title>\n<style>\n  body{font-family:Arial,Helvetica,sans-serif;background:#f4f4f7;margin:0;padding:24px;color:#1a1a1a}\n  .inv{max-width:680px;margin:0 auto;background:#fff;border:1px solid #ddd;border-radius:8px;padding:32px}\n  .head{display:flex;justify-content:space-between;border-bottom:2px solid #1f4e79;padding-bottom:16px;margin-bottom:24px}\n  .brand{font-size:24px;font-weight:bold;color:#1f4e79}\n  .brand small{display:block;font-size:12px;font-weight:normal;color:#666;margin-top:4px}\n  .meta{text-align:left;font-size:14px;line-height:1.8}\n  .meta b{font-size:16px}\n  table{width:100%;border-collapse:collapse;margin:20px 0}\n  th,td{border:1px solid #ddd;padding:10px;text-align:right;font-size:14px}\n  th{background:#eef2f7}\n  .total-row td{font-weight:bold;font-size:16px;background:#eef2f7}\n  .foot{margin-top:24px;font-size:12px;color:#666;border-top:1px solid #eee;padding-top:12px;line-height:1.6}\n</style></head>\n<body>\n  <div class=\"inv\">\n    <div class=\"head\">\n      <div class=\"brand\">Chen Electronics<small>חן אלקטרוניקה · עוסק מורשה 515000000 · רחוב הברזל 30, תל אביב · 03-555-1234</small></div>\n      <div class=\"meta\">\n        <div>{{ $json.fields.DocType || 'חשבונית מס' }} <b>{{ $json.fields.InvoiceNumber }}</b></div>\n        <div>מקור</div>\n        <div>תאריך הפקה: {{ $now.setZone('Asia/Jerusalem').format('dd/MM/yyyy') }}</div>\n        <div>לקוח: {{ $json.fields.CustomerId }}</div>\n      </div>\n    </div>\n    <table>\n      <tr><th>תיאור</th><th>סכום לפני מע\"מ</th><th>מע\"מ ({{ Math.round(($json.fields.VatAmount / $json.fields.Amount) * 100) }}%)</th><th>סה\"כ</th></tr>\n      <tr>\n        <td>מוצרי אלקטרוניקה — לפי הזמנה</td>\n        <td>{{ Number($json.fields.Amount).toLocaleString('he-IL', {minimumFractionDigits: 2}) }} ₪</td>\n        <td>{{ Number($json.fields.VatAmount).toLocaleString('he-IL', {minimumFractionDigits: 2}) }} ₪</td>\n        <td>{{ Number($json.fields.Total).toLocaleString('he-IL', {minimumFractionDigits: 2}) }} ₪</td>\n      </tr>\n      <tr class=\"total-row\"><td colspan=\"3\">סה\"כ לתשלום כולל מע\"מ</td><td>{{ Number($json.fields.Total).toLocaleString('he-IL', {minimumFractionDigits: 2}) }} ₪</td></tr>\n    </table>\n    <div class=\"foot\">\n      מסמך זה הופק אוטומטית על ידי מערכת Chen ERP ואינו דורש חתימה.<br>\n      תנאי תשלום: שוטף. לשאלות: billing@chen-electronics.co.il\n    </div>\n  </div>\n</body>\n</html>\n"
      },
